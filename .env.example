# Copy to .env for local overrides. Never commit .env.
FACT_LEDGER_ENV=dev
FACT_LEDGER_DATABASE_URL=sqlite:///./data/fact_ledger.db
FACT_LEDGER_LOG_LEVEL=INFO
# A LiteLLM model string for `fact-ledger extract`, for example <provider>/<model>. Unset:
# the command fails before any LLM call. The provider key goes in that provider's own variable.
# FACT_LEDGER_LLM_MODEL=
